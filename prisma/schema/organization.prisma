model Organization {
  id           String               @id @default(uuid())
  name         String
  slug         String               @unique
  ownerId      String
  owner        User                 @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt


  
  members      OrganizationMember[]
  teams        Team[]
  projects     Project[]
  activityLogs ActivityLog[]

   payments  Payment[]
  
}