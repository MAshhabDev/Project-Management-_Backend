# Server Environment Setup
NODE_ENV=development
PORT=5000

# PostgreSQL Database Connection (Neon / Supabase / Local)
DATABASE_URL="postgresql://user:password@localhost:5432/mydb?schema=public"

# JWT Authentication Secrets
JWT_ACCESS_SECRET=your_jwt_access_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# Bcrypt Salt Rounds
BCRYPT_SALT_ROUNDS=10

# URLs Configuration
BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id_here

# Redis Cloud Configuration (Upstash)
REDIS_HOST=your_redis_host_here
REDIS_PORT=6379
REDIS_USER=default
REDIS_PASSWORD=your_redis_password_here

# SMTP Email Configuration (Nodemailer / Gmail App Password)
SMTP_USER=your_email@gmail.com
EMAIL_SENDER=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password_here

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# bKash Sandbox Payment Configuration
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_USERNAME=sandboxTokenizedUser02
BKASH_PASSWORD=sandboxTokenizedUser02@12345
BKASH_APP_KEY=your_bkash_app_key
BKASH_APP_SECRET=your_bkash_app_secret
BKASH_CALLBACK_URL=http://localhost:5000/api/v1/payments/bkash/callback

# Seed Credentials (Default Tester Accounts)
ADMIN_NAME="Super Admin"
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=admin@12345

MANAGER_NAME="Tester Manager"
MANAGER_EMAIL=manager@gmail.com
MANAGER_PASSWORD=manager@12345

MEMBER_NAME="Tester Member"
MEMBER_EMAIL=member@gmail.com
MEMBER_PASSWORD=member@12345